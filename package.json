{
  "name": "parkeasy-belfast",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ParkEasy Belfast \u2014 community parking finder for Belfast locals",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-globe-data.mjs && vite build && node scripts/prerender.mjs && node scripts/inject-area-cta.mjs",
    "build:cap": "VITE_APP_CAPACITOR=true vite build",
    "preview": "vite preview",
    "audit": "node scripts/audit-spots.mjs",
    "test": "tests/run-all.sh",
    "globe": "node scripts/generate-globe-data.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/analytics": "^2.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "stripe": "^16.12.0",
    "vite": "^5.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17"
  }
}
